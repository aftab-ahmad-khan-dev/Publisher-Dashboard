# Copy to .env.local for local dev, or set in Vercel → Settings → Environment Variables

# Auth / multi-tenancy (Clerk) — REQUIRED for login. https://dashboard.clerk.com → API keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# LinkedIn Marketing API
VITE_LINKEDIN_CLIENT_ID=
VITE_LINKEDIN_CLIENT_SECRET=
VITE_LINKEDIN_ORG_URN=

# Meta Suite (Instagram + Facebook Graph API)
VITE_META_APP_ID=
VITE_META_APP_SECRET=
VITE_META_PAGE_TOKEN=

# Gmail OAuth (optional — can also set only in api.publisher.com/.env)
VITE_GMAIL_CLIENT_ID=
VITE_GMAIL_CLIENT_SECRET=

# Optional webhook for publish events
VITE_WEBHOOK_URL=

# Backend (api.publisher.com) — enables live publish instead of demo mode
# Dev: defaults to http://localhost:3001/api via .env.development (no .env.local needed)
# Production: set in Vercel → Environment Variables
# VITE_API_BASE_URL=http://localhost:3001/api
