# ── Production (Vercel) ──────────────────────────────────────────────
# Public URL of the deployed API. The email open-tracking pixel + OAuth
# callbacks are built from this, so opens/status only work when it's a
# public URL (localhost is unreachable from Gmail/recipients).
# Must be the LIVE API deployment's own domain (Instagram fetches hosted images
# and OAuth callbacks resolve from this). The API is its own Vercel project here:
API_PUBLIC_URL=https://api-publisher-dashboard.vercel.app
# WEB_URL (above) is the separate frontend domain.
# OAuth redirect URIs to register with each provider:
#   LinkedIn: https://publisher-dashboard.vercel.app/api/auth/linkedin/callback
#   Gmail:    https://publisher-dashboard.vercel.app/api/auth/gmail/callback
#   Reddit:   https://publisher-dashboard.vercel.app/api/auth/reddit/callback

